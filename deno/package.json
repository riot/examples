{
  "name": "deno",
  "version": "1.0.0",
  "description": "Deno SSR Demo",
  "repository": "riot/examples",
  "main": "src/main.ts",
  "author": "Gianluca Guarini",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run build && deno run --import-map=import_map.json -A index.ts",
    "clean": "rm -rf public/*",
    "build-browser": "rollup -c rollup.browser-config.js",
    "build-server": "rollup -c rollup.server-config.js",
    "build": "npm run clean && npm run build-browser && npm run build-server",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "riot",
    "deno"
  ],
  "devDependencies": {
    "@riotjs/cli": "^10.0.0",
    "@riotjs/compiler": "^10.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup-plugin-riot": "^10.0.0"
  },
  "dependencies": {
    "@riotjs/hydrate": "^10.0.0",
    "@riotjs/route": "^10.0.0",
    "@riotjs/ssr": "^10.0.0",
    "erre": "^3.0.1",
    "riot": "^10.0.0"
  }
}
